#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
audit="$root/tools/audit-branch-protection"
bash -n "$audit"
# Bewust grep i.p.v. rg: ripgrep is hier niet geïnstalleerd, en een ontbrekende rg
# (exit 127) is niet te onderscheiden van een echte bevinding — dat gaf valse roods.
grep -qF 'Repository verification' "$audit"
grep -qF 'audit faalt dicht' "$audit"
echo "branch-protection audit contract is valid"
