# Default factory properties (committed to git).
#
#
# --- Orchestrator poll loop -------------------------------------------------
# Fixed backup poll interval (safety net); the poller also wakes immediately on
# every tracker write via a FactoryStateChangedEvent.
SF_POLL_INTERVAL_MS=60000

# --- Parallelism caps -------------------------------------------------------
SF_MAX_PARALLEL_REFINER=1
SF_MAX_PARALLEL_DEVELOPER=2
SF_MAX_PARALLEL_REVIEWER=2
SF_MAX_PARALLEL_TESTER=1
SF_MAX_PARALLEL_TOTAL=4

# --- Loopback / retry behaviour --------------------------------------------
# Max times a single subtask may loop back to the developer before giving up.
SF_MAX_DEVELOPER_LOOPBACKS=5
# Max aantal keren dat een test-bevinding (test-rejected) de hele subtaak-keten
# mag resetten; daarna gaat de story op Error (handmatige triage).
SF_MAX_TEST_CHAIN_RESETS=3
SF_MAX_TRANSIENT_RETRIES=2
SF_AGENT_HARD_TIMEOUT_MINUTES=60
SF_ACTIVE_PHASE_RECOVERY_DELAY_MS=60000
SF_COMPLETION_RECOVERY_POLL_MS=2000
SF_COMPLETION_MAX_ATTEMPTS=8
SF_COMPLETION_LEASE_SECONDS=300
SF_COMPLETION_BACKOFF_MS=2000
SF_COMPLETION_RETENTION_DAYS=30

# --- Agent Runtime v2 ------------------------------------------------------
# Het bearer-token SF_AGENT_RUNTIME_TOKEN is een secret en staat dus alleen in
# secrets.env of in de deploymentomgeving.
SF_AGENT_RUNTIME_URL=https://agent-runtime.vdzonsoftware.nl
SF_AGENT_RUNTIME_POLL_MS=2000
SF_AGENT_RUNTIME_MAX_REPAIR_ATTEMPTS=3
# Maximale wachttijd per Telegram-assistentbeurt; gaat als jobtimeout mee in het Runtime-request.
SF_ASSISTANT_TIMEOUT_SECONDS=3600

# --- Cost / credits monitoring ---------------------------------------------
SF_COST_MONITOR_INTERVAL_MS=300000
SF_CREDITS_PAUSE_DEFAULT_MINUTES=30

# --- Scheduled work/ folder cleanup (achtervang) ----------------------------
SF_WORK_CLEANUP_ENABLED=true
SF_WORK_CLEANUP_RETENTION_DAYS=7

# --- Retentie agent_events (agent-logregels achter het Agent-log-scherm) -----
# Zonder deze opruiming groeit agent_events onbeperkt; hij was de grootste tabel
# van de database (436 MB op 2026-07-29). Verwijderen gebeurt in batches.
SF_AGENT_EVENT_RETENTION_ENABLED=true
SF_AGENT_EVENT_RETENTION_DAYS=30
SF_AGENT_EVENT_RETENTION_BATCH_SIZE=5000
SF_AGENT_EVENT_RETENTION_MAX_BATCHES=20

# --- Retentie agent_runs (de runs zelf, met hun kostenhistorie) -------------
# Ruimer dan agent_events: het agent-log-scherm mag de kostenhistorie langer
# tonen dan de logregels erbij. Lopende runs en runs met een onafgeronde
# completion blijven altijd staan, ongeacht leeftijd.
SF_AGENT_RUN_RETENTION_ENABLED=true
SF_AGENT_RUN_RETENTION_DAYS=90
SF_AGENT_RUN_RETENTION_BATCH_SIZE=1000
SF_AGENT_RUN_RETENTION_MAX_BATCHES=20

# --- Dashboard (non-secret) -------------------------------------------------
