#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
bash -n "$root/tools/audit-documentation"
# Bewust grep i.p.v. rg: ripgrep is hier niet geïnstalleerd, en een ontbrekende rg
# (exit 127) is niet te onderscheiden van een echte bevinding — dat gaf valse roods.
grep -qF 'V15' "$root/tools/audit-documentation"
grep -qF 'pollt adaptief' "$root/tools/audit-documentation"
echo 'documentation audit contract: PASS'
