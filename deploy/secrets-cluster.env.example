# Clusterwaarden voor deploy/seal-secrets.sh: kopieer naar deploy/secrets-cluster.env (gitignored).
# Alle SF_*-sleutels hieronder komen als omgevingsvariabelen in de factory-pod; projects.yaml gaat
# apart mee als deploy/projects-cluster.yaml (gitignored). Zie docs/factory/secrets-local.md.

# GitHub (branches, PR's, merges, releases; ook GH_TOKEN voor de gh-CLI) en packagecleanup.
SF_GITHUB_TOKEN=
SF_GITHUB_PACKAGES_TOKEN=

# Eigen Postgres in de namespace (deploy/base/database.yaml); user/password voeden de StatefulSet.
SF_DATABASE_USER=software_factory
SF_DATABASE_PASSWORD=
SF_DATABASE_URL=postgresql://software_factory:REPLACE_WITH_PASSWORD@database:5432/software_factory
SF_DATABASE_SCHEMA=software_factory

# Agent Runtime v2.
SF_AGENT_RUNTIME_TOKEN=

# Dashboard-login (Google-SSO) en machinetokens.
SF_GOOGLE_CLIENT_ID=
SF_ALLOWED_EMAILS=robbert@vdzon.com
SF_DASHBOARD_REMEMBER_SECRET=
SF_FACTORY_API_TOKEN=
SF_PRODUCT_FACTORY_TOKEN=

# Telegram (leeg = uit) en de publieke dashboard-URL voor links in meldingen.
SF_TELEGRAM_BOT_TOKEN=
SF_TELEGRAM_CHAT_ID=
SF_DASHBOARD_BASE_URL=https://softwarefactory.vdzonsoftware.nl

# Leeg = alle projecten uit de database.
SF_TRACKER_PROJECTS=
